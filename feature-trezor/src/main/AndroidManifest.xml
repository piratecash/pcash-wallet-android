<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Direct-USB Trezor support. required=false so the wallet still installs on devices without
         USB host (they simply cannot use a cable-connected Trezor). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

</manifest>
